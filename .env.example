# ==========================================
# PDF-to-Q&A Pipeline Environment Configuration
# ==========================================

# 1. Target PDF file path
PDF_FILE_PATH=data_set_use.pdf

# 2. Output directory for all pipeline artifacts & records
OUTPUT_DIR=PDF_QA_PIPELINE

# 3. Local Model Paths or Hugging Face Model IDs (Run completely offline/local)
VLLM_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-7B-Instruct
VLLM_VL_MODEL_NAME_OR_PATH=Qwen/Qwen2-VL-7B-Instruct
EMBEDDING_MODEL_NAME_OR_PATH=BAAI/bge-small-en-v1.5

# 4. vLLM Engine Configuration
USE_VLLM=True
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=4096
TENSOR_PARALLEL_SIZE=1

# 5. Chunking & Overlap
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 6. OCR Configuration
OCR_LANG=en
USE_GPU_OCR=False
OCR_CONFIDENCE_ACCEPT=0.95
OCR_CONFIDENCE_REVIEW=0.80

# 7. Q&A Generation Settings
MAX_QA_PER_PERSPECTIVE=10
BATCH_SIZE=4
TRAIN_VAL_SPLIT_RATIO=0.85
